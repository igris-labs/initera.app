{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Initera",
  "version": "0.1.0",
  "identifier": "com.igrislabs.initera",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Initera",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Rahul Vashishtha",
    "copyright": "Copyright © 2026 Rahul Vashishtha",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQjMyOTczNDZFRUY3RjkKUldUNTkrNUdjeW16ZzZGbWZ3Rk5YYmhxcE1tb1VRS1pDdytCRWFub2FuTmw5ZUlkOW4vZXdodzAK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/igris-labs/initera.app/releases/latest/download/latest.json"]
    }
  }
}
